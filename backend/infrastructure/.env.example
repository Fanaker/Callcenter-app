# Recruitment Backend - Environment Variables Example
# Copy this file to .env and fill in your actual values

# =============================================================================
# AWS Configuration
# =============================================================================

# AWS Region where resources will be deployed
AWS_REGION=us-east-1

# AWS Account ID (can be found in AWS Console or via: aws sts get-caller-identity)
AWS_ACCOUNT_ID=123456789012

# AWS Profile to use (set in ~/.aws/credentials)
AWS_PROFILE=default

# =============================================================================
# Infrastructure Configuration
# =============================================================================

# S3 bucket for SAM artifacts (will be created if doesn't exist)
S3_BUCKET=lambda-layers-${AWS_ACCOUNT_ID}-${AWS_REGION}

# CloudFormation Stack name
STACK_NAME=recruitment-backend-prod

# Deployment environment
ENVIRONMENT=prod

# =============================================================================
# Database Configuration
# =============================================================================

# RDS endpoint (e.g., rds-instance.cxyz.us-east-1.rds.amazonaws.com)
DB_HOST=your-rds-endpoint.amazonaws.com

# Database name
DB_NAME=callcenter

# Database username
DB_USER=admin

# Database password (will be stored in Secrets Manager)
DB_PASS=your-secure-password

# Database port (usually 1433 for SQL Server)
DB_PORT=1433

# =============================================================================
# VPC Configuration
# =============================================================================

# VPC ID where Lambda will run
VPC_ID=vpc-12345678

# First private subnet ID
PRIVATE_SUBNET_1=subnet-12345678

# Second private subnet ID
PRIVATE_SUBNET_2=subnet-87654321

# Security group ID for Lambda (should allow outbound to RDS)
LAMBDA_SECURITY_GROUP=sg-12345678

# =============================================================================
# API Configuration
# =============================================================================

# CORS origin for API Gateway
# Use "*" for development/testing
# Use specific domain for production (e.g., "https://yourdomain.com")
CORS_ORIGIN=*

# API stage name (dev, staging, prod)
API_STAGE_NAME=prod

# =============================================================================
# Monitoring & Alerts
# =============================================================================

# Email address for CloudWatch alarm notifications
ALERT_EMAIL=alerts@example.com

# CloudWatch log retention in days
LOG_RETENTION_DAYS=7

# =============================================================================
# Lambda Configuration
# =============================================================================

# Lambda function memory (128-10240 MB)
LAMBDA_MEMORY=512

# Lambda function timeout in seconds (1-900)
LAMBDA_TIMEOUT=30

# Lambda reserved concurrent executions (0 for unreserved)
LAMBDA_RESERVED_CONCURRENCY=100

# =============================================================================
# API Gateway Configuration
# =============================================================================

# Throttling: requests per second
API_THROTTLE_RATE=10

# Throttling: burst limit
API_THROTTLE_BURST=100

# =============================================================================
# Feature Flags (Optional)
# =============================================================================

# Enable X-Ray tracing
ENABLE_XRAY=true

# Enable detailed CloudWatch logs
ENABLE_DETAILED_LOGS=false

# Enable Lambda Insights
ENABLE_LAMBDA_INSIGHTS=true

# Enable Secrets Manager for database password
ENABLE_SECRETS_MANAGER=true

# =============================================================================
# Tags (for AWS resource organization)
# =============================================================================

# Application name tag
TAG_APPLICATION=RecruitmentBackend

# Project tag
TAG_PROJECT=HR-Management

# Team tag
TAG_TEAM=Engineering

# Cost center tag (for billing)
TAG_COST_CENTER=Engineering

# =============================================================================
# Development/Testing (local)
# =============================================================================

# Local Python environment
PYTHON_VERSION=3.11

# Local Lambda testing port
LOCAL_LAMBDA_PORT=3001

# Enable detailed debug output
DEBUG=false

# =============================================================================
# Notes
# =============================================================================

# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. Fill in your actual values for each variable
#
# 3. For sensitive data (DB_PASS), consider using:
#    - AWS Secrets Manager (recommended)
#    - Environment variables
#    - AWS Parameter Store
#
# 4. Never commit .env file to version control
#    It should be added to .gitignore
#
# 5. Database credentials will be:
#    - Stored in AWS Secrets Manager
#    - Rotated automatically (optional)
#    - Never logged or exposed
#
# 6. For production deployment:
#    - Use different values for each environment
#    - Use strong database passwords (min 8 chars, uppercase, numbers, special chars)
#    - Use specific CORS_ORIGIN instead of "*"
#    - Enable CloudTrail for audit logging
#    - Use VPC endpoints for private connectivity
#
# 7. Template variables:
#    - ${AWS_ACCOUNT_ID} → Your AWS account ID
#    - ${AWS_REGION} → Your AWS region
#    - ${ENVIRONMENT} → dev|staging|prod
